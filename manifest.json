{
  "manifest_version": 3,
  "name": "1337 enhancer",
  "version": "2.7.0",
  "description": "A zero dependency chrome extension for enhancing your user experience on 1337x torrent sites",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": false
  },
  "permissions": ["contextMenus", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["dist/*.jpg", "dist/*.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://1337.root.yt/*",
        "*://www.1337.root.yt/*",
        "*://1337x.to/*",
        "*://www.1337x.to/*",
        "*://1337xto.to/*",
        "*://www.1337xto.to/*",
        "*://1337xx.to/*",
        "*://www.1337xx.to/*",
        "*://1337xxx.to/*",
        "*://www.1337xxx.to/*",
        "*://1337x.st/*",
        "*://www.1337x.st/*",
        "*://x1337x.ws/*",
        "*://www.x1337x.ws/*",
        "*://x1337x.eu/*",
        "*://www.x1337x.eu/*",
        "*://x1337x.se/*",
        "*://www.x1337x.se/*",
        "*://1337x.is/*",
        "*://www.1337x.is/*",
        "*://1337x.gd/*",
        "*://www.1337x.gd/*"
      ],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  }
}
